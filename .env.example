# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: absolute site origin for OG tags + canonical (no trailing slash)
# VITE_SITE_URL=https://your-domain.com

# TEMPORARY dev-only login bypass (npm run dev only; ignored in production builds)
# VITE_DEV_AUTO_LOGIN_EMAIL=you@example.com
# VITE_DEV_AUTO_LOGIN_PASSWORD=your-password

# Fitbit data source: leave unset for demo data, or 'google' once the Google Health
# Edge Functions are deployed (see README → Fitbit / Google Health)
# VITE_HEALTH_PROVIDER=google

# ── Web Push notifications — server-side except the public key ────────────────
# Generate a VAPID pair once (see README → Notifications).
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:you@example.com
# Shared secret so only the GitHub Actions scheduler can trigger push-dispatch
# PUSH_CRON_SECRET=random-32-bytes-base64url

# ── Google Health webhooks (post-workout notifications) ───────────────────────
# Shared secret Google returns in the Authorization header on every notification
# HEALTH_WEBHOOK_SECRET=random-32-bytes-base64url
# Google Cloud project NUMBER (not the id) — needed to register the subscriber
# GOOGLE_PROJECT_NUMBER=123456789012
